# =============================================================================
# Radar +EV - Configuração de Ambiente
# =============================================================================
# Copie este arquivo para .env e preencha com suas credenciais reais.
# NUNCA versione o arquivo .env real!

# ---- API-Football (obtida em api-sports.io) ----
RAPIDAPI_KEY=sua_chave_aqui
RAPIDAPI_HOST=v3.football.api-sports.io
# Temporada usada no /teams/statistics. Plano Free bloqueia temporadas
# recentes (200 + errors {plan: "try from 2022 to 2024"}) — manter 2024.
SEASON=2024
# IDs de ligas da API-Football usados na coleta por liga
# (/fixtures?league=X&season=Y&from=...&to=...). Formato CSV aceito.
# (71=Brasil Série A, 61=Ligue 1, 39=Premier League, 140=La Liga,
#  135=Serie A, 78=Bundesliga, 2=UCL, 3=UEL, 13=Libertadores)
LEAGUES=71,61,39,140,135,78,2,3,13

# ---- The Odds API (legado, mantido por compatibilidade) ----
ODDS_API_KEY=chave_antiga_aqui

# ---- Telegram ----
TELEGRAM_TOKEN=token_do_seu_bot
TELEGRAM_CHAT_ID=id_do_chat_ou_grupo

# ---- Limiares de Operação ----
MIN_EV_PERCENT=5.0
PRE_MATCH_HOURS=4

# ---- Regras de Negócio ----
# Lista de times considerados "derby" (separados por vírgula)
DERBY_TEAMS=Flamengo,Fluminense,Boca Juniors,River Plate

# ---- Modelo (futuro) ----
MODEL_PATH=models/poisson_corners.pkl